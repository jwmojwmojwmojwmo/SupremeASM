def str_init_8, reg_to_mem_location, s1, s2, s3, s4, s5, s6, s7, s8;
push 1;
push 2;
push reg_to_mem_location;
pop 2;
ld "s1", 1;
st 1, 2+#0;
ld "s2", 1;
st 1, 2+#1;
ld "s3", 1;
st 1, 2+#2;
ld "s4", 1;
st 1, 2+#3;
ld "s5", 1;
st 1, 2+#4;
ld "s6", 1;
st 1, 2+#5;
ld "s7", 1;
st 1, 2+#6;
ld "s8", 1;
st 1, 2+#7;
pop 2;
pop 1;
enddef;

def str_init_16, reg_to_mem_location, s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15, s16;
push 1;
push 2;
push reg_to_mem_location;
pop 2;
ld "s1", 1;
st 1, 2+#0;
ld "s2", 1;
st 1, 2+#1;
ld "s3", 1;
st 1, 2+#2;
ld "s4", 1;
st 1, 2+#3;
ld "s5", 1;
st 1, 2+#4;
ld "s6", 1;
st 1, 2+#5;
ld "s7", 1;
st 1, 2+#6;
ld "s8", 1;
st 1, 2+#7;
ld "s9", 1;
st 1, 2+#8;
ld "s10", 1;
st 1, 2+#9;
ld "s11", 1;
st 1, 2+#10;
ld "s12", 1;
st 1, 2+#11;
ld "s13", 1;
st 1, 2+#12;
ld "s14", 1;
st 1, 2+#13;
ld "s15", 1;
st 1, 2+#14;
ld "s16", 1;
st 1, 2+#15;
pop 2;
pop 1;
enddef;

def str_terminate, reg_to_mem_location, size;
push 1;
push 2;
push reg_to_mem_location;
pop 2;
ld "\0", 1;
st 1, 2+#size;
pop 2;
pop 1;
enddef;

//CONSTRAINT: reg_to_store_length should not be r2, r3, or r4
def str_length, reg_to_mem_location, reg_to_store_length;
push 2;
push 3;
push 4;
push reg_to_mem_location;
pop 4;
ld "\0", 2;
ld #0, reg_to_store_length;
ld 4+reg_to_store_length, 3;
ife 3, 2, #2;
inc reg_to_store_length;
jmp #-4;
pop 4;
pop 3;
pop 2;
enddef;


def str_prf, reg_to_mem_location;
push 1;
push 2;
push 3;
push 9;
push reg_to_mem_location;
pop 9;
ld #0, 2;
ld #0, 1;
ld 9+1, 3;
ife 3, 2, #3;
prf 3;
inc 1;
jmp #-5;
pop 9;
pop 3;
pop 2;
pop 1;
enddef;
